// https://luals.github.io/wiki/configuration/
{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "Lua.diagnostics.globals": [
        // Suppress "undefined global warnings
        "vim",
        "MiniBufremove",
        "MiniDeps",
        "MiniDiff",
        "MiniExtra",
        "MiniFiles",
        "MiniIcons",
        "MiniMap",
        "MiniPick",
        "MiniStatusline",
        "Snacks"
    ],
    "Lua.format": {
        "enable": true,
        "defaultConfig": {
            "indent_style": "space",
            "indent_size": "3",
            "quote_style": "single"
        }
    }
}
