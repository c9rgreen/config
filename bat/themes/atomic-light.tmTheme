      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#3a6a90</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Markup list bullet</string>
      <key>scope</key>
      <string>markup.list punctuation.definition.list_item</string>
