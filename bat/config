# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Circadia, to match the Ghostty themes. The theme files live in themes/;
# run `bat cache --build` after editing them.
--theme-dark="circadia-dark"
--theme-light="circadia"

# Pick light or dark from the macOS setting instead of asking the terminal.
# Asking does not work inside tmux or in an fzf preview.
--theme="auto:system"
