# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Rex's Sonoran Dusk over Terracotta Noon, to match the terminal and
# nvim/colors/rex-desert.lua. The theme files live in themes/; run
# `bat cache --build` after editing them. (The circadia themes remain in
# themes/ as alternatives.)
--theme-dark="sonoran-dusk"
--theme-light="terracotta-noon"

# Pick light or dark from the macOS setting instead of asking the terminal.
# Asking does not work inside tmux or in an fzf preview.
--theme="auto:system"
