# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Cyclotron Dark over Cyclotron Light, to match the terminal and
# nvim/colors/cyclotron.lua. The theme files live in themes/; run
# `bat cache --build` after editing them.
--theme-dark="cyclotron-dark"
--theme-light="cyclotron-light"

# Pick light or dark from the macOS setting instead of asking the terminal.
# Asking does not work inside tmux or in an fzf preview.
--theme="auto:system"
