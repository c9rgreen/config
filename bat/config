# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Atomic, to match the Ghostty themes. The theme files live in themes/;
# run `bat cache --build` after editing them. (circadia{,-dark},
# chiroptera{,-dark} and monokai-pro{,-light} remain in themes/ as
# alternatives.)
--theme-dark="atomic"
--theme-light="atomic-light"

# Pick light or dark from the macOS setting instead of asking the terminal.
# Asking does not work inside tmux or in an fzf preview.
--theme="auto:system"
