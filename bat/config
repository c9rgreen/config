# bat configuration
# https://github.com/sharkdp/bat#configuration-file

# Circadia, to match the Ghostty themes: the Forest dark variant over the
# shared Warm Parchment light one (themes/circadia.tmTheme). The theme files
# live in themes/; run `bat cache --build` after editing them.
# (circadia-dark, the Warm Ember variant, remains in themes/ as an
# alternative.)
--theme-dark="circadia-forest"
--theme-light="circadia"

# Pick light or dark from the macOS setting instead of asking the terminal.
# Asking does not work inside tmux or in an fzf preview.
--theme="auto:system"
