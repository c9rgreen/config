###############################################################
# A skin for a terminal with a dark background, based on the
# default (dark) variant of atomic.nvim
# https://github.com/kurund/atomic.nvim
#
# This skin uses RGB values so won't work for some terminals.
#
# The palette's red/orange/blue/purple/muted sit below 4.5:1 contrast
# on the background, so text roles use variants blended toward the
# foreground until they reach 4.5:1. Colors used as backgrounds keep
# their original values.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: rgb(245, 236, 215) rgb(22, 40, 48) / rgb(217, 205, 184) rgb(22, 40, 48)
    tree: rgb(42, 61, 68) None / rgb(42, 61, 68) None
    parent: rgb(217, 205, 184) None / rgb(217, 205, 184) None Italic
    file: rgb(245, 236, 215) None / rgb(217, 205, 184) None Italic
    directory: rgb(47, 184, 176) None Bold / rgb(47, 184, 176) None
    exe: rgb(77, 203, 138) None
    link: rgb(149, 132, 184) None
    pruning: rgb(151, 138, 120) None Italic

    # permissions
    perm__: rgb(151, 138, 120) None
    perm_r: rgb(47, 184, 176) None
    perm_w: rgb(232, 197, 71) None
    perm_x: rgb(226, 103, 60) None
    owner: rgb(103, 146, 174) None Bold
    group: rgb(103, 146, 174) None

    count: rgb(47, 184, 176) rgb(30, 48, 56)
    dates: rgb(151, 138, 120) None
    sparse: rgb(232, 197, 71) None

    content_extract: rgb(47, 184, 176) None Italic
    content_match: rgb(226, 103, 60) None Bold

    # git
    git_branch: rgb(149, 132, 184) None
    git_insertions: rgb(77, 203, 138) None
    git_deletions: rgb(214, 111, 95) None
    git_status_current: rgb(151, 138, 120) None
    git_status_modified: rgb(232, 197, 71) None
    git_status_new: rgb(77, 203, 138) None Bold
    git_status_ignored: rgb(151, 138, 120) None
    git_status_conflicted: rgb(214, 111, 95) None
    git_status_other: rgb(196, 122, 152) None

    # highlighting
    selected_line: None rgb(53, 74, 82) / None rgb(30, 48, 56)
    char_match: rgb(226, 103, 60) None
    file_error: rgb(214, 111, 95) None

    flag_label: rgb(151, 138, 120) None
    flag_value: rgb(226, 103, 60) None Bold

    input: rgb(245, 236, 215) rgb(30, 48, 56) / rgb(217, 205, 184) rgb(30, 48, 56) Italic

    # status bar
    status_error: rgb(245, 236, 215) rgb(201, 57, 43)
    status_job: rgb(22, 40, 48) rgb(212, 149, 58)
    status_normal: rgb(217, 205, 184) rgb(30, 48, 56) / None None
    status_italic: rgb(226, 103, 60) rgb(30, 48, 56) Italic / None None
    status_bold: rgb(226, 103, 60) rgb(30, 48, 56) Bold / None None
    status_code: rgb(245, 236, 215) rgb(30, 48, 56) / None None
    status_ellipsis: rgb(245, 236, 215) rgb(30, 48, 56) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(103, 146, 174) None Italic
    purpose_bold: rgb(103, 146, 174) None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: rgb(42, 61, 68) None
    scrollbar_thumb: rgb(151, 138, 120) None

    # documentation
    help_paragraph: None None
    help_bold: rgb(226, 103, 60) None Bold
    help_italic: rgb(149, 132, 184) None Italic
    help_code: rgb(77, 203, 138) rgb(30, 48, 56)
    help_headers: rgb(47, 184, 176) None Bold
    help_table_border: rgb(42, 61, 68) None

    preview_title: rgb(245, 236, 215) rgb(30, 48, 56) / rgb(217, 205, 184) rgb(30, 48, 56)
    preview: rgb(217, 205, 184) None / rgb(217, 205, 184) None
    preview_line_number: rgb(151, 138, 120) rgb(30, 48, 56) / rgb(151, 138, 120) None
    preview_separator: rgb(42, 61, 68) None / rgb(42, 61, 68) None
    preview_match: rgb(22, 40, 48) rgb(232, 197, 71) Bold

    hex_null: rgb(151, 138, 120) None
    hex_ascii_graphic: rgb(217, 205, 184) None
    hex_ascii_whitespace: rgb(151, 138, 120) None
    hex_ascii_other: rgb(212, 149, 58) None
    hex_non_ascii: rgb(214, 111, 95) None

    staging_area_title: rgb(245, 236, 215) rgb(30, 48, 56) / rgb(217, 205, 184) rgb(30, 48, 56)

    mode_command_mark: rgb(22, 40, 48) rgb(224, 90, 45) Bold

    # file system occupation
    good_to_bad_0: rgb(77, 203, 138)
    good_to_bad_1: rgb(77, 203, 138)
    good_to_bad_2: rgb(77, 203, 138)
    good_to_bad_3: rgb(77, 203, 138)
    good_to_bad_4: rgb(232, 197, 71)
    good_to_bad_5: rgb(232, 197, 71)
    good_to_bad_6: rgb(212, 149, 58)
    good_to_bad_7: rgb(212, 149, 58)
    good_to_bad_8: rgb(226, 103, 60)
    good_to_bad_9: rgb(214, 111, 95)
}
