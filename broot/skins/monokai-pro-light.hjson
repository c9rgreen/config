###############################################################
# A skin for a terminal with a light background, based on the
# "light" filter of Monokai Pro:
#   https://monokai.pro/
#   https://github.com/loctvl842/monokai-pro.nvim
# Hexes match Ghostty's bundled "Monokai Pro Light" theme.
#
# This skin uses RGB values so won't work for some terminals.
#
# Roles follow monokai-pro.nvim: the UI tier (dimmed5) carries the
# status bar, borders and panels, the darker sidebar tone sits under
# inputs and counts, yellow is the active/selected accent (upstream's
# active tab and find match), green/orange/red are added/modified/
# deleted, cyan is metadata and purple is git branches.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: rgb(41, 36, 42) rgb(250, 244, 242) / rgb(145, 140, 142) rgb(250, 244, 242)
    tree: rgb(211, 205, 204) None / rgb(211, 205, 204) None
    parent: rgb(145, 140, 142) None / rgb(145, 140, 142) None Italic
    file: rgb(41, 36, 42) None / rgb(145, 140, 142) None Italic
    directory: rgb(38, 157, 105) None Bold / rgb(38, 157, 105) None
    exe: rgb(225, 96, 50) None
    link: rgb(28, 140, 168) None
    pruning: rgb(145, 140, 142) None Italic

    # permissions
    perm__: rgb(145, 140, 142) None
    perm_r: rgb(28, 140, 168) None
    perm_w: rgb(225, 96, 50) None
    perm_x: rgb(38, 157, 105) None
    owner: rgb(28, 140, 168) None Bold
    group: rgb(28, 140, 168) None

    count: rgb(28, 140, 168) rgb(237, 231, 229)
    dates: rgb(145, 140, 142) None
    sparse: rgb(225, 96, 50) None

    content_extract: rgb(28, 140, 168) None Italic
    content_match: rgb(204, 122, 10) None Bold

    # git
    git_branch: rgb(112, 88, 190) None
    git_insertions: rgb(38, 157, 105) None
    git_deletions: rgb(225, 71, 117) None
    git_status_current: rgb(145, 140, 142) None
    git_status_modified: rgb(225, 96, 50) None
    git_status_new: rgb(38, 157, 105) None Bold
    git_status_ignored: rgb(145, 140, 142) None
    git_status_conflicted: rgb(225, 71, 117) None
    git_status_other: rgb(112, 88, 190) None

    # highlighting
    selected_line: None rgb(191, 185, 186) / None rgb(237, 231, 229)
    char_match: rgb(204, 122, 10) None
    file_error: rgb(225, 71, 117) None

    flag_label: rgb(145, 140, 142) None
    flag_value: rgb(204, 122, 10) None Bold

    input: rgb(41, 36, 42) rgb(237, 231, 229) / rgb(145, 140, 142) rgb(237, 231, 229) Italic

    # status bar
    status_error: rgb(250, 244, 242) rgb(225, 71, 117)
    status_job: rgb(250, 244, 242) rgb(225, 96, 50)
    status_normal: rgb(41, 36, 42) rgb(211, 205, 204) / None None
    status_italic: rgb(204, 122, 10) rgb(211, 205, 204) Italic / None None
    status_bold: rgb(204, 122, 10) rgb(211, 205, 204) Bold / None None
    status_code: rgb(112, 107, 110) rgb(211, 205, 204) / None None
    status_ellipsis: rgb(112, 107, 110) rgb(211, 205, 204) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(28, 140, 168) None Italic
    purpose_bold: rgb(28, 140, 168) None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: rgb(211, 205, 204) None
    scrollbar_thumb: rgb(145, 140, 142) None

    # documentation
    help_paragraph: None None
    help_bold: rgb(225, 96, 50) None Bold
    help_italic: rgb(112, 88, 190) None Italic
    help_code: rgb(204, 122, 10) rgb(237, 231, 229)
    help_headers: rgb(38, 157, 105) None Bold
    help_table_border: rgb(211, 205, 204) None

    preview_title: rgb(41, 36, 42) rgb(211, 205, 204) / rgb(145, 140, 142) rgb(211, 205, 204)
    preview: rgb(145, 140, 142) None / rgb(145, 140, 142) None
    preview_line_number: rgb(191, 185, 186) rgb(211, 205, 204) / rgb(191, 185, 186) None
    preview_separator: rgb(211, 205, 204) None / rgb(211, 205, 204) None
    preview_match: rgb(41, 36, 42) rgb(204, 122, 10) Bold

    hex_null: rgb(145, 140, 142) None
    hex_ascii_graphic: rgb(41, 36, 42) None
    hex_ascii_whitespace: rgb(145, 140, 142) None
    hex_ascii_other: rgb(225, 96, 50) None
    hex_non_ascii: rgb(225, 71, 117) None

    staging_area_title: rgb(41, 36, 42) rgb(211, 205, 204) / rgb(145, 140, 142) rgb(211, 205, 204)

    mode_command_mark: rgb(41, 36, 42) rgb(204, 122, 10) Bold

    # file system occupation
    good_to_bad_0: rgb(38, 157, 105)
    good_to_bad_1: rgb(38, 157, 105)
    good_to_bad_2: rgb(38, 157, 105)
    good_to_bad_3: rgb(38, 157, 105)
    good_to_bad_4: rgb(204, 122, 10)
    good_to_bad_5: rgb(204, 122, 10)
    good_to_bad_6: rgb(225, 96, 50)
    good_to_bad_7: rgb(225, 96, 50)
    good_to_bad_8: rgb(225, 71, 117)
    good_to_bad_9: rgb(225, 71, 117)
}
