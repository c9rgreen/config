###############################################################
# A skin for a terminal with a light background, based on the
# light normal-contrast wing of Chiroptera, Dawid Kurek's
# LAB-space day/night color system:
#   https://dawikur.dev/chiroptera/
#   https://github.com/dawikur/chiroptera
#
# This skin uses RGB values so won't work for some terminals.
#
# Roles follow upstream's core.vim: the UI tier (bg_bright) carries
# the status bar, borders and panels, the dim blue is the selection
# (Visual), blue is the "selected" accent, green/yellow/red are
# added/modified/deleted, cyan is output and magenta input.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: rgb(93, 92, 90) rgb(221, 218, 207) / rgb(116, 115, 111) rgb(221, 218, 207)
    tree: rgb(195, 193, 184) None / rgb(195, 193, 184) None
    parent: rgb(116, 115, 111) None / rgb(116, 115, 111) None Italic
    file: rgb(93, 92, 90) None / rgb(116, 115, 111) None Italic
    directory: rgb(71, 71, 69) None Bold / rgb(71, 71, 69) None
    exe: rgb(95, 96, 0) None
    link: rgb(15, 105, 82) None
    pruning: rgb(116, 115, 111) None Italic

    # permissions
    perm__: rgb(116, 115, 111) None
    perm_r: rgb(34, 101, 105) None
    perm_w: rgb(139, 76, 0) None
    perm_x: rgb(95, 96, 0) None
    owner: rgb(34, 101, 105) None Bold
    group: rgb(34, 101, 105) None

    count: rgb(34, 101, 105) rgb(234, 231, 219)
    dates: rgb(116, 115, 111) None
    sparse: rgb(139, 76, 0) None

    content_extract: rgb(34, 101, 105) None Italic
    content_match: rgb(0, 79, 82) None Bold

    # git
    git_branch: rgb(143, 67, 103) None
    git_insertions: rgb(95, 96, 0) None
    git_deletions: rgb(179, 32, 27) None
    git_status_current: rgb(116, 115, 111) None
    git_status_modified: rgb(139, 76, 0) None
    git_status_new: rgb(95, 96, 0) None Bold
    git_status_ignored: rgb(116, 115, 111) None
    git_status_conflicted: rgb(179, 32, 27) None
    git_status_other: rgb(143, 67, 103) None

    # highlighting
    selected_line: None rgb(165, 230, 233) / None rgb(234, 231, 219)
    char_match: rgb(0, 79, 82) None
    file_error: rgb(179, 32, 27) None

    flag_label: rgb(116, 115, 111) None
    flag_value: rgb(0, 79, 82) None Bold

    input: rgb(93, 92, 90) rgb(234, 231, 219) / rgb(116, 115, 111) rgb(234, 231, 219) Italic

    # status bar
    status_error: rgb(221, 218, 207) rgb(179, 32, 27)
    status_job: rgb(221, 218, 207) rgb(139, 76, 0)
    status_normal: rgb(93, 92, 90) rgb(195, 193, 184) / None None
    status_italic: rgb(0, 79, 82) rgb(195, 193, 184) Italic / None None
    status_bold: rgb(0, 79, 82) rgb(195, 193, 184) Bold / None None
    status_code: rgb(71, 71, 69) rgb(195, 193, 184) / None None
    status_ellipsis: rgb(71, 71, 69) rgb(195, 193, 184) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(34, 101, 105) None Italic
    purpose_bold: rgb(34, 101, 105) None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: rgb(195, 193, 184) None
    scrollbar_thumb: rgb(116, 115, 111) None

    # documentation
    help_paragraph: None None
    help_bold: rgb(108, 58, 0) None Bold
    help_italic: rgb(143, 67, 103) None Italic
    help_code: rgb(95, 96, 0) rgb(234, 231, 219)
    help_headers: rgb(15, 105, 82) None Bold
    help_table_border: rgb(195, 193, 184) None

    preview_title: rgb(93, 92, 90) rgb(195, 193, 184) / rgb(116, 115, 111) rgb(195, 193, 184)
    preview: rgb(116, 115, 111) None / rgb(116, 115, 111) None
    preview_line_number: rgb(116, 115, 111) rgb(195, 193, 184) / rgb(116, 115, 111) None
    preview_separator: rgb(195, 193, 184) None / rgb(195, 193, 184) None
    preview_match: rgb(221, 218, 207) rgb(0, 79, 82) Bold

    hex_null: rgb(116, 115, 111) None
    hex_ascii_graphic: rgb(93, 92, 90) None
    hex_ascii_whitespace: rgb(116, 115, 111) None
    hex_ascii_other: rgb(139, 76, 0) None
    hex_non_ascii: rgb(179, 32, 27) None

    staging_area_title: rgb(93, 92, 90) rgb(195, 193, 184) / rgb(116, 115, 111) rgb(195, 193, 184)

    mode_command_mark: rgb(221, 218, 207) rgb(34, 101, 105) Bold

    # file system occupation
    good_to_bad_0: rgb(95, 96, 0)
    good_to_bad_1: rgb(95, 96, 0)
    good_to_bad_2: rgb(95, 96, 0)
    good_to_bad_3: rgb(95, 96, 0)
    good_to_bad_4: rgb(139, 76, 0)
    good_to_bad_5: rgb(139, 76, 0)
    good_to_bad_6: rgb(108, 58, 0)
    good_to_bad_7: rgb(108, 58, 0)
    good_to_bad_8: rgb(148, 0, 11)
    good_to_bad_9: rgb(179, 32, 27)
}
