###############################################################
# A skin for a terminal with a dark background, based on the
# Cyclotron Dark theme. Colors match nvim/colors/cyclotron.lua.
#
# This skin uses RGB values so won't work for some terminals.
#
# Directories take the function teal, git and errors the red,
# and the orange accent marks matches and active moments. Usage
# ramps green -> yellow -> orange -> red.
#
# Doc at https://dystroy.org/broot/skins/
###############################################################

skin: {
    default: rgb(207, 206, 195) rgb(26, 24, 19) / rgb(196, 190, 175) rgb(26, 24, 19)
    tree: rgb(50, 48, 40) None / rgb(50, 48, 40) None
    parent: rgb(196, 190, 175) None / rgb(196, 190, 175) None Italic
    file: rgb(207, 206, 195) None / rgb(196, 190, 175) None Italic
    directory: rgb(100, 195, 189) None Bold / rgb(100, 195, 189) None
    exe: rgb(119, 184, 132) None
    link: rgb(166, 144, 201) None
    pruning: rgb(124, 118, 106) None Italic

    # permissions
    perm__: rgb(124, 118, 106) None
    perm_r: rgb(100, 195, 189) None
    perm_w: rgb(200, 179, 98) None
    perm_x: rgb(119, 184, 132) None
    owner: rgb(100, 195, 189) None Bold
    group: rgb(100, 195, 189) None

    count: rgb(100, 195, 189) rgb(32, 31, 25)
    dates: rgb(124, 118, 106) None
    sparse: rgb(200, 179, 98) None

    content_extract: rgb(100, 195, 189) None Italic
    content_match: rgb(253, 135, 96) None Bold

    # git
    git_branch: rgb(166, 144, 201) None
    git_insertions: rgb(119, 184, 132) None
    git_deletions: rgb(254, 122, 106) None
    git_status_current: rgb(124, 118, 106) None
    git_status_modified: rgb(200, 179, 98) None
    git_status_new: rgb(119, 184, 132) None Bold
    git_status_ignored: rgb(124, 118, 106) None
    git_status_conflicted: rgb(254, 122, 106) None
    git_status_other: rgb(224, 182, 105) None

    # highlighting
    selected_line: None rgb(58, 56, 46) / None rgb(32, 31, 25)
    char_match: rgb(253, 135, 96) None
    file_error: rgb(254, 122, 106) None

    flag_label: rgb(124, 118, 106) None
    flag_value: rgb(253, 135, 96) None Bold

    input: rgb(207, 206, 195) rgb(32, 31, 25) / rgb(196, 190, 175) rgb(32, 31, 25) Italic

    # status bar
    status_error: rgb(26, 24, 19) rgb(254, 122, 106)
    status_job: rgb(26, 24, 19) rgb(253, 135, 96)
    status_normal: rgb(196, 190, 175) rgb(32, 31, 25) / None None
    status_italic: rgb(253, 135, 96) rgb(32, 31, 25) Italic / None None
    status_bold: rgb(253, 135, 96) rgb(32, 31, 25) Bold / None None
    status_code: rgb(207, 206, 195) rgb(32, 31, 25) / None None
    status_ellipsis: rgb(207, 206, 195) rgb(32, 31, 25) Bold / None None

    purpose_normal: None None
    purpose_italic: rgb(100, 195, 189) None Italic
    purpose_bold: rgb(100, 195, 189) None Bold
    purpose_ellipsis: None None

    # scrollbar
    scrollbar_track: rgb(50, 48, 40) None
    scrollbar_thumb: rgb(124, 118, 106) None

    # documentation
    help_paragraph: None None
    help_bold: rgb(253, 135, 96) None Bold
    help_italic: rgb(166, 144, 201) None Italic
    help_code: rgb(119, 184, 132) rgb(32, 31, 25)
    help_headers: rgb(100, 195, 189) None Bold
    help_table_border: rgb(50, 48, 40) None

    preview_title: rgb(207, 206, 195) rgb(32, 31, 25) / rgb(196, 190, 175) rgb(32, 31, 25)
    preview: rgb(196, 190, 175) None / rgb(196, 190, 175) None
    preview_line_number: rgb(124, 118, 106) rgb(32, 31, 25) / rgb(124, 118, 106) None
    preview_separator: rgb(50, 48, 40) None / rgb(50, 48, 40) None
    preview_match: rgb(26, 24, 19) rgb(200, 179, 98) Bold

    hex_null: rgb(124, 118, 106) None
    hex_ascii_graphic: rgb(196, 190, 175) None
    hex_ascii_whitespace: rgb(124, 118, 106) None
    hex_ascii_other: rgb(224, 182, 105) None
    hex_non_ascii: rgb(254, 122, 106) None

    staging_area_title: rgb(207, 206, 195) rgb(32, 31, 25) / rgb(196, 190, 175) rgb(32, 31, 25)

    mode_command_mark: rgb(26, 24, 19) rgb(253, 135, 96) Bold

    # file system occupation
    good_to_bad_0: rgb(119, 184, 132)
    good_to_bad_1: rgb(119, 184, 132)
    good_to_bad_2: rgb(119, 184, 132)
    good_to_bad_3: rgb(119, 184, 132)
    good_to_bad_4: rgb(200, 179, 98)
    good_to_bad_5: rgb(200, 179, 98)
    good_to_bad_6: rgb(253, 135, 96)
    good_to_bad_7: rgb(253, 135, 96)
    good_to_bad_8: rgb(254, 122, 106)
    good_to_bad_9: rgb(254, 122, 106)
}
