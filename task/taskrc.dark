data.location=~/.local/share/task
hooks.location=~/.config/task/hooks

# GitLab UDAs synced by bugwarrior (regenerate with `bugwarrior uda`)
include ~/.config/task/bugwarrior-udas.rc

# https://unix.stackexchange.com/questions/367151/how-to-override-warning-in-taskwarrior
verbose=blank,footnote,label,new-id,affected,edit,special,project,sync,unwait

# Use dark colors
include ~/.config/task/circadia-forest-dark.theme
# Circadia Dark (Warm Ember) alternative:
# include ~/.config/task/circadia-dark.theme

# Sync server and encryption secret. Kept out of git; on a new machine create
# sync.rc with the sync.server.url, sync.server.client_id and
# sync.encryption_secret lines, or task will refuse to start.
include ~/.config/task/sync.rc
