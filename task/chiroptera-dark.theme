# Chiroptera (dark, normal contrast), for Taskwarrior.
# From Chiroptera, Dawid Kurek's LAB-space day/night color system:
#   https://dawikur.dev/chiroptera/
#   https://github.com/dawikur/chiroptera
#
# Taskwarrior colors are 256-color, not truecolor, so each value is the
# xterm-256 index upstream's generator pairs with the palette hex (the
# cterm half of colors/chiroptera_dark_normal.vim):
#
#   bg         #373737 -> 236    red      #fe7a65 -> 209  bright #fea391 -> 216
#   bg_dim     #2d2d2e -> 235    green    #a9a72d -> 142  bright #c3bf46 -> 179
#   bg_bright  #4c4c4a -> 238    yellow   #e68d32 -> 173  bright #fea753 -> 215
#   fg         #a4a29b -> 247    blue     #6dadaf -> 73   bright #85c6c9 -> 116
#   fg_dim     #8b8a84 -> 102    magenta  #dc89ad -> 175  bright #f6a2c6 -> 218
#   fg_bright  #bdbbb2 -> 249    cyan     #61b197 -> 72   bright #79caaf -> 115
#   red_dim    #760004 -> 88
#
# Roles follow upstream's core.vim: red is deleted/error, yellow modified,
# green added, blue selected (the accent), cyan output. Due urgency ramps
# yellow (due) -> bright yellow (today) -> red (overdue).
#
# Enable from taskrc.dark:  include /Users/cgreen/.config/task/chiroptera-dark.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=
color.label.sort=
color.alternate=on color235
color.header=color73
color.footnote=color102
color.warning=bold color173
color.error=color247 on color88
color.debug=color72

# Task state
color.completed=
color.deleted=
color.active=color236 on color73
color.recurring=color72
color.scheduled=on color235
color.until=
color.blocked=color247 on color238
color.blocking=color236 on color102

# Project
color.project.none=

# Priority
color.uda.priority.H=color249
color.uda.priority.M=color247
color.uda.priority.L=color102

# Tags
color.tag.next=color215
color.tag.none=
color.tagged=

# Due
color.due.today=bold color215
color.due=color173
color.overdue=color209

# Report: burndown
color.burndown.done=on color142
color.burndown.pending=on color209
color.burndown.started=on color173

# Report: history
color.history.add=color236 on color173
color.history.delete=color236 on color209
color.history.done=color236 on color142

# Report: summary
color.summary.background=color247 on color236
color.summary.bar=color236 on color73

# Command: calendar
color.calendar.due.today=color236 on color215
color.calendar.due=color236 on color173
color.calendar.holiday=color236 on color175
color.calendar.scheduled=
color.calendar.overdue=color236 on color209
color.calendar.today=color236 on color73
color.calendar.weekend=on color235
color.calendar.weeknumber=color73

# Command: sync
color.sync.added=color142
color.sync.changed=color173
color.sync.rejected=color209

# Command: undo
color.undo.after=color142
color.undo.before=color209
