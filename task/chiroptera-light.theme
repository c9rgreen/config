# Chiroptera (light, normal contrast), for Taskwarrior.
# From Chiroptera, Dawid Kurek's LAB-space day/night color system:
#   https://dawikur.dev/chiroptera/
#   https://github.com/dawikur/chiroptera
#
# Taskwarrior colors are 256-color, not truecolor, so each value is the
# xterm-256 index upstream's generator pairs with the palette hex (the
# cterm half of colors/chiroptera_light_normal.vim):
#
#   bg         #dddacf -> 188    red      #b3201b -> 124  bright #94000b -> 88
#   bg_dim     #eae7db -> 254    green    #5f6000 -> 58   bright #494900 -> 58
#   bg_bright  #c3c1b8 -> 250    yellow   #8b4c00 -> 94   bright #6c3a00 -> 58
#   fg         #5d5c5a -> 59     blue     #226569 -> 23   bright #004f52 -> 23
#   fg_dim     #74736f -> 242    magenta  #8f4367 -> 95   bright #762c51 -> 89
#   fg_bright  #474745 -> 237    cyan     #0f6952 -> 23   bright #00513e -> 23
#   red_dim    #fed0c6 -> 224
#
# The light wing's deep hues collapse in the 256 cube: blue and cyan both
# land on 23 and bright yellow shares 58 with green, so this theme leans on
# blue (accent), yellow (due), red (alarm), green (done) and magenta
# (holiday) and lets cyan ride 23 with blue. Due urgency ramps yellow (due)
# -> bold yellow (today) -> red (overdue).
#
# Enable from taskrc.light:  include /Users/cgreen/.config/task/chiroptera-light.theme

rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.

# General decoration
color.label=
color.label.sort=
color.alternate=on color254
color.header=color23
color.footnote=color242
color.warning=bold color94
color.error=color59 on color224
color.debug=color23

# Task state
color.completed=
color.deleted=
color.active=color188 on color23
color.recurring=color23
color.scheduled=on color254
color.until=
color.blocked=color59 on color250
color.blocking=color188 on color242

# Project
color.project.none=

# Priority
color.uda.priority.H=color237
color.uda.priority.M=color59
color.uda.priority.L=color242

# Tags
color.tag.next=color94
color.tag.none=
color.tagged=

# Due
color.due.today=bold color94
color.due=color94
color.overdue=color124

# Report: burndown
color.burndown.done=on color58
color.burndown.pending=on color124
color.burndown.started=on color94

# Report: history
color.history.add=color188 on color94
color.history.delete=color188 on color124
color.history.done=color188 on color58

# Report: summary
color.summary.background=color59 on color188
color.summary.bar=color188 on color23

# Command: calendar
color.calendar.due.today=color188 on color94
color.calendar.due=color188 on color94
color.calendar.holiday=color188 on color95
color.calendar.scheduled=
color.calendar.overdue=color188 on color124
color.calendar.today=color188 on color23
color.calendar.weekend=on color254
color.calendar.weeknumber=color23

# Command: sync
color.sync.added=color58
color.sync.changed=color94
color.sync.rejected=color124

# Command: undo
color.undo.after=color58
color.undo.before=color124
