# Theme based on the light variant of atomic.nvim
# https://github.com/kurund/atomic.nvim
#
# btop themes are hex-only and can't follow the terminal's luma, so this
# pairs with atomic.theme: switch color_theme in btop.conf (or from
# btop's options menu, Esc > Options) when the Ghostty theme flips.
#
# The palette's teal/yellow/pink/amber/muted sit below 4.5:1 contrast on
# the background, so they're blended toward the foreground until they
# reach 4.5:1. Gradient endpoints reuse the same adjusted values.

# Main background and foreground
theme[main_bg]="#f2f0e8"
theme[main_fg]="#2a2920"

# Title color for boxes
theme[title]="#2a2920"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b84820"

# Selected item in processes box
theme[selected_bg]="#cbc8bc"
theme[selected_fg]="#2a2920"

# Color of inactive/disabled text
theme[inactive_fg]="#726d62"

# Color of text appearing on top of graphs
theme[graph_text]="#4a4538"

# Background color of the percentage meters
theme[meter_bg]="#d4d1c7"

# Misc colors for processes box (tree branches, info text)
theme[proc_misc]="#1c7a74"

# Box outline colors
theme[cpu_box]="#1c7a74"
theme[mem_box]="#3a7a4a"
theme[net_box]="#3a6a90"
theme[proc_box]="#b84820"

# Divider line between boxes
theme[div_line]="#cbc8bc"

# CPU temperature graph: cool teal to hot red
theme[temp_start]="#1c7a74"
theme[temp_mid]="#7e6c20"
theme[temp_end]="#b83a2e"

# CPU load graph: calm green to loaded red
theme[cpu_start]="#3a7a4a"
theme[cpu_mid]="#7e6c20"
theme[cpu_end]="#b83a2e"

# Memory free meter
theme[free_start]="#3a7a4a"
theme[free_mid]="#3a7a4a"
theme[free_end]="#3a7a4a"

# Memory cached meter
theme[cached_start]="#1c7a74"
theme[cached_mid]="#1c7a74"
theme[cached_end]="#1c7a74"

# Memory available meter
theme[available_start]="#3a6a90"
theme[available_mid]="#3a6a90"
theme[available_end]="#3a6a90"

# Memory used meter: fills toward red
theme[used_start]="#7e6c20"
theme[used_mid]="#886826"
theme[used_end]="#b83a2e"

# Download graph
theme[download_start]="#1c7a74"
theme[download_mid]="#1c7a74"
theme[download_end]="#3a7a4a"

# Upload graph
theme[upload_start]="#6a558a"
theme[upload_mid]="#6a558a"
theme[upload_end]="#a05573"

# Per-process CPU graph in the details pane
theme[process_start]="#1c7a74"
theme[process_mid]="#7e6c20"
theme[process_end]="#b84820"
