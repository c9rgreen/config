// Monokai Pro, matching Ghostty's bundled "Monokai Pro" / "Monokai Pro
// Light" themes and loctvl842/monokai-pro.nvim's pro/light filters:
//   https://monokai.pro/
//   https://github.com/loctvl842/monokai-pro.nvim
//
// Colors are written as hex rather than as ANSI names so the two themes
// stay pinned to the Monokai palette whichever terminal theme is active.
//
// Roles follow monokai-pro.nvim: the UI tier (dimmed5) carries chips,
// frames and dividers; the selection is Ghostty's selection-background;
// yellow is the active-tab and find-match hue, so the active chip and the
// focused frame ride it, with orange for transient states (search,
// rename). Emphases are the syntax accents: yellow, orange, green, purple.

themes {
    // Monokai Pro
    monokai-pro {
        // fg on bg
        text_unselected {
            base "#fcfcfa"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        // fg on the selection background (Ghostty's selection-background)
        text_selected {
            base "#fcfcfa"
            background "#5b595c"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        // The active mode / tab chip: text knocked out of the yellow, with
        // the emphases as the only tones that read on yellow
        ribbon_selected {
            base "#2d2a2e"
            background "#ffd866"
            emphasis_0 "#221f22"
            emphasis_1 "#2d2a2e"
            emphasis_2 "#19181a"
            emphasis_3 "#403e41"
        }

        // Inactive chips sit on the UI tier. emphasis_1 doubles as the
        // hovered-chip background (with base as its text), so it stays a
        // background tone rather than the fg the other emphases use.
        ribbon_unselected {
            base "#fcfcfa"
            background "#403e41"
            emphasis_0 "#ffd866"
            emphasis_1 "#403e41"
            emphasis_2 "#a9dc76"
            emphasis_3 "#fc9867"
        }

        table_title {
            base "#ffd866"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        table_cell_selected {
            base "#fcfcfa"
            background "#5b595c"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        table_cell_unselected {
            base "#fcfcfa"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        list_selected {
            base "#fcfcfa"
            background "#5b595c"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        list_unselected {
            base "#fcfcfa"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#a9dc76"
            emphasis_3 "#ab9df2"
        }

        // Unfocused frames fall back to the terminal default when this
        // section is missing, so it must be set explicitly. The UI tier
        // matches the inactive tmux pane borders.
        frame_unselected {
            base "#403e41"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#ab9df2"
            emphasis_3 "#a9dc76"
        }

        frame_selected {
            base "#ffd866"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#fc9867"
            emphasis_2 "#ab9df2"
            emphasis_3 "#a9dc76"
        }

        // Transient states (search, rename) take the orange
        frame_highlight {
            base "#fc9867"
            background "#2d2a2e"
            emphasis_0 "#ab9df2"
            emphasis_1 "#fc9867"
            emphasis_2 "#fc9867"
            emphasis_3 "#fc9867"
        }

        exit_code_success {
            base "#a9dc76"
            background "#2d2a2e"
            emphasis_0 "#ffd866"
            emphasis_1 "#2d2a2e"
            emphasis_2 "#ab9df2"
            emphasis_3 "#fc9867"
        }

        exit_code_error {
            base "#ff6188"
            background "#2d2a2e"
            emphasis_0 "#fc9867"
            emphasis_1 "#2d2a2e"
            emphasis_2 "#ffd866"
            emphasis_3 "#ab9df2"
        }

        multiplayer_user_colors {
            player_1 "#ffd866"
            player_2 "#ab9df2"
            player_3 "#fc9867"
            player_4 "#78dce8"
            player_5 "#a9dc76"
            player_6 "#ff6188"
            player_7 "#c1c0c0"
            player_8 "#fcfcfa"
            player_9 "#939293"
            player_10 "#403e41"
        }
    }

    // Monokai Pro Light
    monokai-pro-light {
        // fg on bg
        text_unselected {
            base "#29242a"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        // fg on the selection background (Ghostty's selection-background)
        text_selected {
            base "#29242a"
            background "#bfb9ba"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        // The active mode / tab chip: text knocked out of the yellow, with
        // the emphases as the only tones that read on yellow
        ribbon_selected {
            base "#29242a"
            background "#cc7a0a"
            emphasis_0 "#29242a"
            emphasis_1 "#29242a"
            emphasis_2 "#706b6e"
            emphasis_3 "#918c8e"
        }

        // Inactive chips sit on the UI tier. emphasis_1 doubles as the
        // hovered-chip background (with base as its text), so it stays a
        // background tone rather than the fg the other emphases use.
        ribbon_unselected {
            base "#29242a"
            background "#d3cdcc"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#d3cdcc"
            emphasis_2 "#269d69"
            emphasis_3 "#e16032"
        }

        table_title {
            base "#cc7a0a"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        table_cell_selected {
            base "#29242a"
            background "#bfb9ba"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        table_cell_unselected {
            base "#29242a"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        list_selected {
            base "#29242a"
            background "#bfb9ba"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        list_unselected {
            base "#29242a"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#269d69"
            emphasis_3 "#7058be"
        }

        // Unfocused frames fall back to the terminal default when this
        // section is missing, so it must be set explicitly. The UI tier
        // matches the inactive tmux pane borders.
        frame_unselected {
            base "#d3cdcc"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#7058be"
            emphasis_3 "#269d69"
        }

        frame_selected {
            base "#cc7a0a"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#e16032"
            emphasis_2 "#7058be"
            emphasis_3 "#269d69"
        }

        // Transient states (search, rename) take the orange
        frame_highlight {
            base "#e16032"
            background "#faf4f2"
            emphasis_0 "#7058be"
            emphasis_1 "#e16032"
            emphasis_2 "#e16032"
            emphasis_3 "#e16032"
        }

        exit_code_success {
            base "#269d69"
            background "#faf4f2"
            emphasis_0 "#cc7a0a"
            emphasis_1 "#faf4f2"
            emphasis_2 "#7058be"
            emphasis_3 "#e16032"
        }

        exit_code_error {
            base "#e14775"
            background "#faf4f2"
            emphasis_0 "#e16032"
            emphasis_1 "#faf4f2"
            emphasis_2 "#cc7a0a"
            emphasis_3 "#7058be"
        }

        multiplayer_user_colors {
            player_1 "#cc7a0a"
            player_2 "#7058be"
            player_3 "#e16032"
            player_4 "#1c8ca8"
            player_5 "#269d69"
            player_6 "#e14775"
            player_7 "#706b6e"
            player_8 "#29242a"
            player_9 "#918c8e"
            player_10 "#d3cdcc"
        }
    }
}
