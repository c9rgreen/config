"vim: foldmethod=marker foldlevel=0

" Plugins {{{
" vim-plug installs itself and any missing plugins on startup. Both live next
" to this vimrc (autoload/plug.vim and plugged/), which git ignores.
let s:vimdir = expand('<sfile>:p:h')
if empty(glob(s:vimdir . '/autoload/plug.vim'))
  silent execute '!curl -fsSLo ' . shellescape(s:vimdir . '/autoload/plug.vim')
        \ . ' --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim'
endif

call plug#begin(s:vimdir . '/plugged')
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-fugitive'
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-vinegar'
Plug 'tpope/vim-unimpaired'
" fzf's Vim plugin ships with the binary; use Homebrew's copy when present.
if isdirectory('/opt/homebrew/opt/fzf')
  Plug '/opt/homebrew/opt/fzf'
else
  Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
endif
Plug 'junegunn/fzf.vim'
call plug#end()

autocmd VimEnter * if len(filter(values(g:plugs), '!isdirectory(v:val.dir)'))
      \ | PlugInstall --sync | source $MYVIMRC
      \ | endif
" }}}

filetype plugin indent on
syntax enable
packadd! editorconfig

" Options {{{
set nocompatible
set autoindent
set smartindent
set infercase
set nowrap
set linebreak
set breakindent
set hidden
set guioptions=mce
set clipboard^=unnamed,unnamedplus
set formatoptions=tcroqjn
set showmatch
set expandtab
set tabstop=4
set shiftwidth=0
set diffopt=vertical
set autowrite
set autowriteall
set shortmess+=Ic
set noswapfile
set showcmd
set hlsearch
set incsearch
set wildmenu
set wildignore+=*.git,*venv/*,*node_modules/*,*vendor/*,*__pycache__/*,*.aux,*.cls,*dist/*,*output/*,tags
set wildignorecase
set shell=fish

" Status line: plugin/statusline.vim

set spelllang=en_us
set tags^=./.git/tags
set laststatus=2
set showtabline=2
set foldlevel=5
set foldmethod=indent
set virtualedit=all
set isfname+=32
set belloff+=ctrlg
set mouse=a
set ttyfast
set signcolumn=yes
set fillchars=stl:\ ,stlnc:\ ,vert:\ ,fold:\ ,foldopen:\ ,foldsep:\ ,eob:\ ,diff:-
set completeopt=menu,menuone,preview,noselect,longest
set omnifunc=syntaxcomplete#Complete
set backspace=indent,eol,start
set smarttab
set ttimeout
set ttimeoutlen=100
set ruler
set scrolloff=5
set sidescroll=1
set sidescrolloff=5
set display+=lastline
set display+=truncate
set listchars=tab:>\ ,trail:-,extends:>,precedes:<,nbsp:+
set sessionoptions-=options
set viewoptions-=options
set nolangremap
set linespace=1
" }}}

" Variables {{{
" Use <space> instead of <\> as the leader key
let mapleader = "\<Space>"
" Enable folding in markdown
let g:markdown_folding = 1
" Highlight fenced code in markdown
let g:markdown_fenced_languages = ['html', 'javascript', 'css', 'json', 'yaml',
  \ 'python', 'sh', 'bash=sh', 'vim', 'lua', 'mermaid']
" NetRW
let g:netrw_liststyle = 3
let g:netrw_banner = 0
" Change the cursor shape depending on mode
" https://stackoverflow.com/questions/12030278/how-to-change-cursor-shape-in-vim-when-entering-insert-mode-with-macos-terminal
let &t_SI="\033[5 q" " Blinking bar for insert mode
let &t_EI="\033[2 q" " Steady block for normal mode
" }}}

" Abbreviations {{{
iabbrev <expr> :date: strftime("%Y-%m-%d")
" }}}

" Mappings {{{
noremap <silent> k gk
noremap <silent> j gj
vnoremap < <gv
vnoremap > >gv

" Go to file
nnoremap <leader>e :edit **/*

" Edit a neigboring file
nnoremap <leader>n :e <C-R>=expand("%:p:h") . "/" <CR>

" Go to buffer
nnoremap <leader>r :buffer **/*

" Go to tag
nnoremap <leader>a :tag *

" Hard wrap
nnoremap <leader>h gqip$

" List buffers
nnoremap ,, :ls<CR>

" Set a blinking vertical bar (I-beam) for Insert mode
let &t_SI = "\e[5 q"

" Set a steady block cursor for Normal mode (when leaving Insert/Replace)
let &t_EI = "\e[2 q"

" Set a blinking underline cursor for Replace mode
let &t_SR = "\e[3 q"

" Optional: Set the initial cursor shape when Vim starts
" This is usually the block cursor for normal mode.
" The .= appends to any existing t_ti setting.
let &t_ti .= "\e[2 q"

" Optional: Ensure cursor is reset when Vim exits
" The .= appends to any existing t_te setting.
let &t_te .= "\e[2 q"

" Rex's Merino Dark over Merino Light, following the macOS appearance the same
" way the fish task wrapper does (fish/conf.d/taskwarrior.fish).
if system('defaults read -g AppleInterfaceStyle 2>/dev/null') =~# 'Dark'
  set background=dark
else
  set background=light
endif

" Curly, colored underlines for spelling. Vim only knows how to draw them
" when told the escape codes; these are the modern (kitty/Ghostty) forms, so
" only send them to terminals known to understand them.
if $TERM_PROGRAM =~? '\v^(rex|ghostty|wezterm|kitty|iTerm\.app)$'
  let &t_Cs = "\e[4:3m"
  let &t_Ce = "\e[4:0m"
  let &t_Us = "\e[4:2m"
  let &t_ds = "\e[4:4m"
  let &t_Ds = "\e[4:5m"
  let &t_8u = "\e[58:2::%lu:%lu:%lum"
endif

colorscheme merino
