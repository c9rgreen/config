# vim: set filetype=ghostty

shell-integration = fish
font-size = "15"
font-family = "Monaspace Neon"
font-family-italic = "Monaspace Radon"
font-family-bold-italic = "Monaspace Radon"
# Monaspace: calt is texture healing, liga spaces out repeats like ///.
# ss01-ss10 are the coding ligature groups, which are off by default.
font-feature = calt, liga
font-feature = ss01, ss02, ss03, ss04, ss05, ss06, ss07, ss08, ss09, ss10
font-thicken = true
font-thicken-strength = 1
theme = dark:circadia_forest_dark, light:circadia_light
mouse-shift-capture = true
mouse-hide-while-typing = true
unfocused-split-opacity = 1
macos-option-as-alt = true
keybind = global:f12=toggle_quick_terminal
clipboard-read = allow
clipboard-write = allow

